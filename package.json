{
  "name": "wr-audit-logger",
  "version": "0.5.0",
  "description": "Automatic audit logging for PostgreSQL",
  "keywords": [
    "audit-log",
    "audit-logging",
    "drizzle",
    "drizzle-orm",
    "pg",
    "postgres",
    "postgresql"
  ],
  "homepage": "https://github.com/Jun-del/wr-audit-logger#readme",
  "bugs": {
    "url": "https://github.com/Jun-del/wr-audit-logger/issues"
  },
  "license": "ISC",
  "author": "White Room",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jun-del/wr-audit-logger.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "ci": "pnpm run build && pnpm run check:package && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "coverage": "vitest run --coverage",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "local-release": "changeset version && changeset publish",
    "prepare": "husky",
    "prepublishOnly": "pnpm run ci",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "AUDIT_RUN_INTEGRATION_TESTS=true dotenvx run -- vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "typecheck:types": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:types:v1": "tsc -p tsconfig.typecheck.v1.json --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@dotenvx/dotenvx": "^1.75.1",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pg": "^8.23.1",
    "publint": "^0.3.25",
    "tsdown": "^0.20.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2 || ^1.0.0-rc.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "vite>esbuild": "^0.28.1",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    }
  }
}
